#!/bin/sh
# Nhắc bàn giao ngay sau mỗi lần commit.
#
# Lý do có hook này: tôi đã quên gửi danh sách năm link cuối phiên hai lần
# (2026-11-27, 2026-11-28) dù luật đã ghi trong AGENTS.md. Bước cuối dựa vào
# trí nhớ thì sẽ quên lại — nên để máy nhắc.
#
# Bật (mỗi máy một lần, .git/config không đi theo repo):
#     git config core.hooksPath .githooks

cd "$(git rev-parse --show-toplevel)" || exit 0

echo ""
echo "─────────────────────────────────────────────"
echo " BÀN GIAO — còn 1 bước nữa mới được báo xong"
echo "─────────────────────────────────────────────"

PY=python3
command -v $PY >/dev/null 2>&1 || PY=python

# 1. Commit vừa rồi có kèm nhật ký + sổ việc chưa?
if ! $PY tools/kiem_ban_giao.py 2>/dev/null; then
    echo ""
    echo "⚠ Commit vừa rồi THIẾU bàn giao (xem lỗi ở trên)."
fi

# 2. In năm link cố định, gọi thử từng cái.
echo ""
$PY tools/ban_giao.py 2>/dev/null || \
    echo "⚠ Chạy tay: python3 tools/ban_giao.py"

echo ""
echo "→ Gửi NGUYÊN danh sách trên cho người dùng trong câu trả lời cuối."
echo "─────────────────────────────────────────────"
